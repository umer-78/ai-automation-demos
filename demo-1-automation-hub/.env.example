# Copy to .env (in this folder or in backend/). Everything is optional: with no keys the hub
# runs fully offline on SQLite with template AI output, simulated Slack and email.

# --- App ---------------------------------------------------------------------
ENVIRONMENT=development
PUBLIC_BASE_URL=http://localhost:8000
AUTO_SEED=true
CORS_ORIGINS=http://localhost:5173

# --- Database: Supabase Postgres (Project settings > Database > Session pooler) ---
# DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# --- Security -------------------------------------------------------------------
# Shared secret for Make.com -> API calls (X-Automation-Key header). Required in production.
AUTOMATION_API_KEY=
# Enables /api/admin/* (reset demo, register the Airtable webhook)
ADMIN_TOKEN=
# Access code for the Settings page and, once real client data is in, for the whole app
OWNER_TOKEN=
# Optional read-only access code for teammates
VIEWER_TOKEN=
# Encrypts API keys saved from the Settings page (any long random string; required in production)
APP_SECRET=
# Public AI / write actions allowed per visitor IP per hour
RATE_LIMIT_PER_HOUR=30

# --- AI (Anthropic API) -------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_FAST_MODEL=claude-haiku-5-5

# --- Slack + email -----------------------------------------------------------------
SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Northwind Automation <automation@your-domain.com>

# --- Airtable -------------------------------------------------------------------------
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE=Clients

# --- Make.com webhooks (when set, the dashboard form and Airtable bridge go through Make) ---
MAKE_ONBOARDING_WEBHOOK_URL=
MAKE_OFFBOARDING_WEBHOOK_URL=

# --- Supabase Storage for website drafts --------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=site-drafts

# --- Reporting pipeline -----------------------------------------------------------------
METRICS_SOURCE=mock
METRICS_API_URL=
METRICS_LOOKBACK_DAYS=14
CPA_ALERT_THRESHOLD=0.25

# --- Live ad data (or paste these on the Settings page) -----------------------------------
# Every connected account must report in this currency; others are left out with a warning.
REPORT_CURRENCY=USD
# Google: one OAuth client (type Web application) reads Google Ads, Search Console and GA4.
# The refresh token is written by "Sign in with Google" on the Settings page.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_ADS_DEVELOPER_TOKEN=
# Manager (MCC) account ID, if the client accounts sit under one
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Meta: a Business system user token with ads_read
META_ACCESS_TOKEN=
META_CONVERSION_ACTIONS=lead,purchase
# Minutes between automatic syncs in real-data mode (0 turns it off)
LIVE_SYNC_MINUTES=60
LIVE_SYNC_DAYS=3
LIVE_BACKFILL_DAYS=60
