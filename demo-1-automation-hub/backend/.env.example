# Demo 1, Agency Automation Hub: environment variables
# Set these in the Render dashboard (or export them locally). Never commit real values.
# SITE_URL is read when the frontend is built, for canonical links, the sitemap and social cards.
# Every integration is optional: anything left blank is skipped and clearly labelled in the UI.

# --- Database: Supabase Postgres (Project Settings > Database > Connection string, "Transaction pooler") ---
# Leave blank locally to use a SQLite file.
DATABASE_URL=

# --- Claude (client briefs, weekly summaries, website drafts) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# --- Airtable (Clients table; see airtable/README.md) ---
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=
AIRTABLE_CLIENTS_TABLE=Clients

# --- Slack incoming webhook (welcome messages, failure alerts, off-boarding summaries) ---
SLACK_WEBHOOK_URL=

# --- Supabase Storage (Module C drafts). Use the service_role key, server-side only. ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=site-drafts

# --- Shared secret for Make.com webhooks and the scheduled job (any long random string) ---
HUB_API_TOKEN=

# --- Optional: email the brief to the account manager (otherwise it is saved as a draft) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Optional tuning ---
RATE_LIMIT_PER_MINUTE=30

# --- Public address of the deployed site, e.g. https://northwind-hub.onrender.com ---
SITE_URL=
