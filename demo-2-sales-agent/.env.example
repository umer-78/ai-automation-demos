# Copy to .env (in this folder or in backend/). Everything is optional: with no keys the agent
# runs fully offline on SQLite, with the deterministic planner, the research cache of real public
# sources and a simulated Slack feed.

# --- App ---------------------------------------------------------------------------------
ENVIRONMENT=development
PUBLIC_BASE_URL=http://localhost:8000
AUTO_SEED=true
CORS_ORIGINS=http://localhost:5174

# Database. Leave empty for local SQLite. For Supabase use the Session pooler connection string:
# postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# --- Security ------------------------------------------------------------------------------
# Required in production. Sent by schedulers as the X-Automation-Key header.
AUTOMATION_API_KEY=
# Enables POST /api/admin/reset (X-Admin-Token header).
ADMIN_TOKEN=
AGENT_RUNS_PER_HOUR=6
REVIEW_ACTIONS_PER_HOUR=300
LIVE_RUNS_PER_DAY=40

# --- Agent brain (Anthropic API with tool use) ----------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
AGENT_MAX_TURNS=16
AGENT_TIME_BUDGET_S=150
AGENT_TARGET_LEADS=12
AGENT_OUTREACH_DRAFTS=5
AGENT_FOLLOWUPS=5
FEEDBACK_CONTEXT_SIZE=20
# Used only for the cost estimate shown on each run (USD per million tokens).
PRICE_INPUT_PER_MTOK=3.0
PRICE_OUTPUT_PER_MTOK=15.0

# --- Web research ---------------------------------------------------------------------------
# Tavily Search API (free plan: 1,000 credits a month, 1 credit per basic search).
# Without a key the agent searches backend/data/research_snapshot.json (real public pages).
TAVILY_API_KEY=
RESEARCH_MAX_RESULTS=6

# --- Seller identity used in drafts ------------------------------------------------------------
SELLER_COMPANY=Acme Cloud Security
REP_NAME=Jordan Reyes
REP_TITLE=Account Executive

# --- Internal alerts (the sales team's own Slack channel, never customers) ----------------------
SLACK_WEBHOOK_URL=
SLACK_CHANNEL_LABEL=#acme-sales-ops
