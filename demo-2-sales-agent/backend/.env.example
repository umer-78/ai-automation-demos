# Demo 2, Acme Cloud Security sales agent: environment variables
# Set these in the Render dashboard (or export them locally). Never commit real values.
# Every integration is optional: without keys the agent runs offline on saved real web results, and the page says so.

# --- Database: Supabase Postgres (Project Settings > Database > Connection string, "Transaction pooler") ---
# Leave blank locally to use a SQLite file. Tables are created on first start (or apply supabase/001_schema.sql).
DATABASE_URL=

# --- Claude runs the agent loop and writes the emails ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# --- Tavily web search. Free plan: 1,000 credits a month, one per basic search. Blank = saved real results from 21 Nov 2026. ---
TAVILY_API_KEY=

# --- Slack incoming webhook: an alert when a run fails ---
SLACK_WEBHOOK_URL=

# --- Public address of the deployed site, read when the frontend is built (canonical links, sitemap, social cards) ---
SITE_URL=

# --- Optional tuning ---
RATE_LIMIT_PER_MINUTE=40
AGENT_RUN_TIMEOUT_S=170
AGENT_MAX_TURNS=40
# Pause between steps of the offline agent so the page can show each one (0 turns it off).
OFFLINE_STEP_SECONDS=0.35
# Run the offline agent once on an empty database so the demo opens with real work (0 turns it off).
SEED_FIRST_RUN=1
